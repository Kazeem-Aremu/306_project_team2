digraph State {
  graph [fontname="Helvetica", rankdir=TB, pad=0.4, nodesep=0.9, ranksep=0.75, label="State diagram - Request lifecycle", labelloc=t, fontsize=16];
  node [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", fillcolor="#E7F1FB", color="#3B6EA8", width=1.6];
  edge [fontname="Helvetica", fontsize=10, color="#444444"];
  init [shape=circle, style=filled, fillcolor=black, label="", width=0.22, fixedsize=true];
  fin [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.18, fixedsize=true];
  Submitted; Reviewed; Assigned; InProgress [label="In Progress"]; Waiting; Resolved; Closed; Cancelled [fillcolor="#F0EFEC"]; Closed [fillcolor="#E5F4E4"];
  init -> Submitted [label=" requester submits"];
  Submitted -> Reviewed [label=" review: set category\n and priority [Coordinator]"];
  Reviewed -> Assigned [label=" assign technician\n [Coordinator]"];
  Assigned -> InProgress [label=" start work\n [assigned Technician]"];
  InProgress -> Resolved [label=" resolve\n [Technician; resolution\n note entered]"];
  Resolved -> Closed [label=" close [Coordinator]"];
  InProgress -> Waiting [label=" wait for parts\n or user reply\n [Technician]"];
  Waiting -> InProgress [label=" resume\n [Technician]"];
  Assigned -> Reviewed [label=" unassign\n [Coordinator]", constraint=false];
  Resolved -> InProgress [label=" reopen\n [Coordinator]", constraint=false];
  Submitted -> Cancelled [label=" cancel [Coordinator,\n or requester who\n created it]"];
  Reviewed -> Cancelled [label=" cancel\n [Coordinator]"];
  Assigned -> Cancelled [label=" cancel\n [Coordinator]"];
  Waiting -> Cancelled [label=" cancel\n [Coordinator]"];
  Closed -> fin; Cancelled -> fin;
  {rank=same; Waiting; Resolved}
  {rank=same; Closed; Cancelled}
}
